---
import Button from './ui/button.astro'
---

<form id='contact-form' class='needs-validation' novalidate>
  <div class='mb-5 input-group'>
    <input
      type='text'
      placeholder='Nombre Completo'
      required
      class='input w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-0 border-gray-300 focus:border-gray-600'
      name='user_name'
    />
    <label class='user-label'>Nombre Completo</label>
    <div class='empty-feedback invalid-feedback text-red-400 text-sm mt-1'>
      Por favor, proporciona tu nombre completo.
    </div>
  </div>
  <div class='mb-5 input-group'>
    <input
      id='email_address'
      type='email'
      placeholder='Dirección de Correo Electrónico'
      name='user_email'
      required
      class='input w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-0 border-gray-300 focus:border-gray-600'
    />
    <label for='email_address' class='user-label'
      >Dirección de Correo Electrónico</label
    >
    <div class='empty-feedback text-red-400 text-sm mt-1'>
      Por favor, proporciona tu dirección de correo electrónico.
    </div>
    <div class='invalid-feedback text-red-400 text-sm mt-1'>
      Por favor, proporciona una dirección de correo electrónico válida.
    </div>
  </div>
  <div class='mb-5'>
    <select
      name='service'
      class='appearance-none hover:placeholder-shown:bg-emerald-500 relative text-green-600 bg-transparent ring-0 outline-none border placeholder-violet-700 text-sm font-bold rounded-xl focus:ring-violet-500 focus:border-violet-500 block w-full p-4'>
      <option value='Desarrollo Web'>Desarrollo Web</option>
      <option value='Desarrollo de software empresarial'
        >Desarrollo de software empresarial</option
      >
      <option value='Automatizaciones'>Automatizaciones</option>
      <option value='Auditorias de Sistemas'>Auditorias de Sistemas</option>
      <option value='Desarrollo de ChatBots'>Desarrollo de ChatBots</option>
      <option value='Implementación de IA'>Implementación de IA</option>
      <option value='Sincronizacion de Datos'>Sincronizacion de Datos</option>
    </select>
  </div>
  <div class='mb-3 input-group'>
    <textarea
      name='message'
      required
      placeholder='Tu Mensaje'
      class='input w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none h-36 focus:ring-0 border-gray-300 focus:border-gray-600'
    ></textarea>
    <label class='user-label'>Tu Mensaje</label>
    <div class='empty-feedback invalid-feedback text-red-400 text-sm mt-1'>
      Por favor, ingresa tu mensaje.
    </div>
  </div>
  <input type='hidden' name='subject' value='Contacto SoftCorp - Sitio Web' />
  <Button type='submit' size='lg' block class='button type1' />
  <div id='result' class='mt-3 text-center'></div>
</form>

<style>
  /* CSS DEL BOTON DE CONFIRMACION */
  .button {
    height: 50px;
    width: 150px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.5s ease-in-out;
  }

  .type1::after {
    content: 'Enviar';
    height: 50px;
    width: 150px;
    background-color: #008080;
    color: #fff;
    position: absolute;
    top: 0%;
    left: 0%;
    transform: translateY(50px);
    font-size: 1.2rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s ease-in-out;
  }

  .type1::before {
    content: 'Contactar';
    height: 50px;
    width: 150px;
    background-color: #fff;
    color: #008080;
    position: absolute;
    top: 0%;
    left: 0%;
    transform: translateY(0px) scale(1.2);
    font-size: 1.2rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s ease-in-out;
  }

  .type1:hover::after {
    transform: translateY(0) scale(1.2);
  }

  .type1:hover::before {
    transform: translateY(-50px) scale(0) rotate(120deg);
  }

  /* CSS DE EL FORMULARIO */
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }

  .input-group {
    position: relative;
  }

  .input {
    border: solid 1.5px #9e9e9e;
    border-radius: 1rem;
    background: none;
    padding: 1rem;
    font-size: 1rem;
    color: #f5f5f5;
    transition: border 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input:-webkit-autofill,
  .input:-webkit-autofill:hover,
  .input:-webkit-autofill:focus,
  .input:-webkit-autofill:active {
    -webkit-background-clip: text;
    -webkit-text-fill-color: #f5f5f5;
    transition: background-color 5000s ease-in-out 0s;
    box-shadow: inset 0 0 20px 20px #0d1425;
  }

  .user-label {
    position: absolute;
    left: 15px;
    color: #e8e8e8;
    pointer-events: none;
    transform: translateY(1rem);
    transition: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input:focus,
  .input:valid {
    outline: none;
    border: 1.5px solid #3fb86f;
  }

  .input:focus ~ .user-label,
  .input:valid ~ .user-label {
    transform: translateY(-50%) scale(0.8);
    background-color: #0d1425;
    background-color: none;
    padding: 0 0.2em;
    color: #3fb86f;
  }

  /* Estilos responsivos para el select */
  select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.5rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    border: solid 1.5px #9e9e9e;
  }

  select:focus {
    border: 1.5px solid #3fb86f;
    outline: none;
  }

  /* Estilos para mensajes de éxito/error */
  .success-message {
    color: #3fb86f;
    font-weight: 600;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background-color: rgba(63, 184, 111, 0.1);
    border: 1px solid #3fb86f;
  }

  .error-message {
    color: #dc3545;
    font-weight: 600;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background-color: rgba(220, 53, 69, 0.1);
    border: 1px solid #dc3545;
  }

  /* Estilos responsivos */
  @media (max-width: 640px) {
    .button {
      width: 100%;
    }

    .type1::after,
    .type1::before {
      width: 100%;
    }
  }
</style>
